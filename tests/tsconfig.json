{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
   "include": ["*.ts", "unit/**/*.ts", "integration/**/*.ts", "e2e/**/*.ts", "fixtures/**/*.ts"]}